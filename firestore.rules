rules_version = '2';

// Canonical Firebase Security Rules (Batch 3)
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function for staff/admin auth
    function isAdmin() {
      return request.auth != null && (
        get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role in ['Admin', 'Owner']
        || request.auth.token.email in ['admin@jezsy.com', 'admin@jezsycollection.com']
      );
    }

    // ── USERS ──
    match /users/{userId} {
      allow read: if request.auth.uid == userId || isAdmin();
      allow write: if request.auth.uid == userId && 
                      request.resource.data.firstName is string &&
                      request.resource.data.lastName is string &&
                      request.resource.data.email is string &&
                      !('password' in request.resource.data) &&  // Prevent password writes
                      !('userId' in request.resource.data);      // Prevent redundant field
    }

    // ── STAFF ──
    match /staff/{docId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }
    
    // ── PRODUCTS ──
    match /products/{productId} {
      allow read: if true;  // Public
      allow write: if isAdmin() &&
                      request.resource.data.name is string &&
                      request.resource.data.price is number &&
                      request.resource.data.price >= 0 &&
                      !('id' in request.resource.data);  // Doc ID is source of truth
    }

    // ── INVENTORY ──
    match /inventory/{docId} {
      allow read: if request.auth != null;
      allow update: if request.auth != null;
      allow create, delete: if isAdmin();
    }
    
    // ── RESERVATIONS ──
    match /reservations/{reservationId} {
      allow read: if request.auth.uid == resource.data.customerId || isAdmin();
      allow create: if request.auth != null &&
                       request.resource.data.customerId == request.auth.uid &&
                       request.resource.data.date is string &&
                       request.resource.data.status == 'pending' &&
                       !('id' in request.resource.data);
      allow update: if isAdmin() || request.auth.uid == resource.data.customerId;
      allow delete: if isAdmin();
      
      // NESTED ITEMS subcollection
      match /items/{itemId} {
        allow read: if request.auth.uid == get(/databases/$(database)/documents/reservations/$(reservationId)).data.customerId || isAdmin();
        allow write: if isAdmin();
      }
    }
    
    // ── WARDROBE ITEMS ──
    match /wardrobeItems/{itemId} {
      allow read: if request.auth.uid == resource.data.userId || isAdmin();
      allow create: if request.auth.uid == request.resource.data.userId;
      allow update: if request.auth.uid == resource.data.userId;
      allow delete: if request.auth.uid == resource.data.userId || isAdmin();
    }
    
    // ── OUTFITS ──
    match /outfits/{outfitId} {
      allow read: if request.auth.uid == resource.data.userId || isAdmin();
      allow create: if request.auth.uid == request.resource.data.userId;
      allow update: if request.auth.uid == resource.data.userId;
      allow delete: if request.auth.uid == resource.data.userId;
    }
    
    // ── CONVERSATIONS ──
    match /conversations/{convId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() &&
                      request.resource.data.customerId is string &&
                      request.resource.data.unread is number &&
                      !('customId' in request.resource.data);
      
      // MESSAGES subcollection
      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null &&
                         request.resource.data.sender == request.auth.uid &&
                         request.resource.data.text is string &&
                         request.resource.data.text.size() > 0;
        allow update: if false;  // Immutable
        allow delete: if isAdmin();
      }
    }

    // ── MESSAGES (Root-level fallback if used) ──
    match /messages/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
                       request.resource.data.sender == request.auth.uid &&
                       request.resource.data.text is string &&
                       !('id' in request.resource.data);
    }
    
    // ── FEEDBACK ──
    match /feedback/{feedbackId} {
      allow read: if isAdmin();
      allow create: if request.auth != null &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.message is string &&
                       request.resource.data.message.size() >= 10 &&
                       request.resource.data.message.size() <= 2000;
      allow update, delete: if false;  // Immutable
    }

    // ── SETTINGS ──
    match /settings/{docId} {
      allow read, write: if isAdmin();
    }

    // ── ANALYTICS ──
    match /analyticsConvRate/{docId} {
      allow read, write: if request.auth != null;
    }

    // ── DEVICES ──
    match /devices/{fingerprint} {
      allow read, create, update: if request.auth != null;
      allow delete: if isAdmin();
    }

    // ── LOGS ──
    match /logs/{docId} {
      allow read, create: if request.auth != null;
      allow update, delete: if false; // immutable
    }

    // ── NOTIFICATIONS ──
    match /notifications/{docId} {
      allow read, create, update, delete: if request.auth != null;
    }

    // ── CATEGORIES ──
    match /categories/{docId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // ── CATCH ALL ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
