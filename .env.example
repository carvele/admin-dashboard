# ============================================================================
# JezSy Collection Admin Dashboard - Environment Variables
# ============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control
#
# For local development:
#   cp .env.example .env
#   Edit .env with your Firebase credentials
#
# For production, set these via your hosting provider's environment config
# ============================================================================

# ─────────────────────────────────────────────────────────────────────────
# FIREBASE CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────
# Get these from Firebase Console > Project Settings > Web App Config
# https://console.firebase.google.com/

# Firebase API Key - public key for frontend auth
VITE_FIREBASE_API_KEY=AIzaSyBh-wuWE9OnrtsSgD-R0mlSgeBG2TyWC4U

# Auth Domain - your Firebase auth domain
VITE_FIREBASE_AUTH_DOMAIN=jeszybotiquear.firebaseapp.com

# Project ID - Firebase project identifier
VITE_FIREBASE_PROJECT_ID=jeszybotiquear

# Storage Bucket - Cloud Storage bucket for images/files
VITE_FIREBASE_STORAGE_BUCKET=jeszybotiquear.firebasestorage.app

# Messaging Sender ID - for Cloud Messaging (optional if not using FCM)
VITE_FIREBASE_MESSAGING_SENDER_ID=539455278934

# App ID - Firebase app identifier
VITE_FIREBASE_APP_ID=1:539455278934:web:8c3c509a70b3f68362d0f7

# Measurement ID - for Google Analytics (optional)
VITE_FIREBASE_MEASUREMENT_ID=G-DVJY23BWPV

# ─────────────────────────────────────────────────────────────────────────
# APPLICATION CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────

# App environment (development, staging, production)
VITE_APP_ENV=development

# Enable debug logging in console (true/false)
VITE_APP_DEBUG=true
