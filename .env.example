# ============================================================================
# JezSy Collection Admin Dashboard — Environment Variables
# ============================================================================
# Copy this file to .env and fill in your actual values.
# DO NOT commit .env to version control.
#
#   cp .env.example .env
#
# For production, set these via your hosting provider's environment config.
# ============================================================================

# ─────────────────────────────────────────────────────────────────────────
# SUPABASE (backend + auth) — src/lib/supabaseClient.js
# ─────────────────────────────────────────────────────────────────────────
# Project URL and public anon key (Supabase Dashboard > Project Settings > API).
# The anon key is public-by-design; RLS is the enforcement boundary.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────────────────
# CLOUDINARY (image uploads) — src/lib/storage.js
# ─────────────────────────────────────────────────────────────────────────
# Cloud name and an UNSIGNED upload preset. Constrain the preset in the
# Cloudinary console (images only, max size, fixed folder) — see
# docs/SECURITY_HARDENING_PLAN.md item 3.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# ─────────────────────────────────────────────────────────────────────────
# SENTRY (error monitoring) — src/main.jsx  (optional)
# ─────────────────────────────────────────────────────────────────────────
VITE_SENTRY_DSN=

# ─────────────────────────────────────────────────────────────────────────
# SUPABASE EDGE FUNCTION SECRETS (set via `npx supabase secrets set`)
# ─────────────────────────────────────────────────────────────────────────
# Used by `create-staff-account` Edge Function to email staff credentials
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=JezSy Collection <onboarding@resend.dev>
# SITE_URL=https://admin-dashboard-byq.pages.dev
