    "@supabase/supabase-js": "^2.110.1",
    "@types/three": "^0.185.4",
    "dompurify": "^3.3.3",
    "framer-motion": "^12.36.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lodash.debounce": "^4.0.8",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-loading-skeleton": "^3.5.0",
